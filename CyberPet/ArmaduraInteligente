public class ArmaduraInteligente extends MejoraDecorator{
    public ArmaduraInteligente(MascotaRobot mascota) {
        super(mascota);
    }
    public String descripcion(){
        return mascota.descripcion() + " agrega proteccion";
    }
    public double energia(){
        return mascota.energia() + 30;
    }
    public double poder(){
        return mascota.poder();
    }
}
