public class AlasHolograficas extends MejoraDecorator{
    public AlasHolograficas(MascotaRobot mascota) {
        super(mascota);
    }
    public String descripcion(){
        return mascota.descripcion() + " agrega capacidad de vuelo";
    }
    public double poder(){
        return mascota.poder() + 20;
    }
    public double energia() {
        return mascota.energia();
    }
}
