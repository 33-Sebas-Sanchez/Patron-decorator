public class CanonLaser extends MejoraDecorator{
    public CanonLaser(MascotaRobot mascota) {
        super(mascota);
    }
    public String descripcion(){
        return mascota.descripcion() + " agrega capacidad de ataque";
    }
    public double poder(){
        return mascota.poder() + 50;
    }
    public double energia(){
        return mascota.energia();
    }
}
