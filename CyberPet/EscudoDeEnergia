public class EscudoDeEnergia extends MejoraDecorator{
    public EscudoDeEnergia(MascotaRobot mascota) {
        super(mascota);
    }
    public String descripcion(){
        return mascota.descripcion() + " agrega defensa energetica";
    }
    public double energia(){
        return mascota.energia() + 15;
    }
    
    public double poder() {
        return mascota.poder();
    }
}
